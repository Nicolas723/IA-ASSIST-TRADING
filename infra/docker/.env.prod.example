# Copy to .env.prod (ignored by Git) and fill in. Used by docker-compose.prod.yml.

# Public name of the server. Without your own domain, use the free
# <your-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=

# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=

# Login for the web UI. Generate the hash on the server with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# and paste it below. In this file write every $ as $$ (Compose escaping).
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# Database password for the server (long random string, different from dev):
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Time zone for log timestamps (the bot itself works in UTC).
TZ=UTC
