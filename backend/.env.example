# =============================================================================
# AI Trading Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Trading Assistant"
APP_ENV=development          # development | paper | production
APP_VERSION=0.1.0
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
APP_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1              # Use >1 only in production with gunicorn

# ---------------------------------------------------------------------------
# PostgreSQL + TimescaleDB
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://trading_user:change-this-password@localhost:5432/trading_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false           # Set true to log all SQL (dev only)

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=               # Leave empty for dev
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TTL_SECONDS=300         # Default cache TTL (5 minutes)

# ---------------------------------------------------------------------------
# Exchange APIs
# ---------------------------------------------------------------------------
# Binance (Fase 1 — start with testnet)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true          # MUST be false for real trading
BINANCE_SANDBOX=true

# Bybit (Phase 2+)
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=true

# OKX (Phase 2+)
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true

# Kraken (Phase 2+)
KRAKEN_API_KEY=
KRAKEN_SECRET=

# Coinbase Advanced Trade (Phase 2+)
COINBASE_API_KEY=
COINBASE_SECRET=

# Encryption key for storing API keys in DB (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
# Primary: OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1        # Low temp for consistency in analysis

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-5
ANTHROPIC_MAX_TOKENS=8192

# Google Gemini
GOOGLE_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Ollama (local models)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenRouter (unified gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Per-process safety cap. 0 = unlimited. In-memory, resets at UTC midnight/restart.
LLM_DAILY_TOKEN_BUDGET=0

# Optional cost estimate in USD per one million tokens. Leave at 0 when pricing
# is unknown: the API then reports cost as null instead of pretending it is free.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

# Provider routing: try the primary first, then these providers in order.
# Fallbacks are skipped automatically unless that provider has credentials.
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDERS=["google","anthropic","openrouter"]

# Current live committee uses the global primary/fallback chain above.

# ---------------------------------------------------------------------------
# Risk Management
# ---------------------------------------------------------------------------
MAX_DAILY_LOSS_PCT=2.0                  # Circuit breaker: halt if daily loss exceeds this
MAX_MAX_DRAWDOWN_PCT=10.0               # Circuit breaker: max peak-to-trough drawdown
MAX_POSITION_SIZE_PCT=5.0               # Max % of equity in a single asset (existing + new)
MAX_PORTFOLIO_EXPOSURE_PCT=80.0         # Max % of equity in all open positions combined
MAX_MAX_RISK_PER_TRADE_PCT=1.5          # Risk to stop-loss as % of equity
MAX_OPEN_POSITIONS=10
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0

# ---------------------------------------------------------------------------
# Trading Modes
# ---------------------------------------------------------------------------
EXECUTION_MODE=paper          # backtest | paper | real
ENABLE_REAL_TRADING=false     # MUST be explicitly set to true for real trading
REQUIRE_MANUAL_CONFIRMATION=true  # Double-confirm before real orders
PAPER_TRADING_INITIAL_BALANCE=10000.0
PAPER_TRADING_CURRENCY=USDT

# Real-trading safety rails
REAL_TRADING_EXCHANGE=binance
REAL_TRADING_MAX_NOTIONAL=1000
REAL_TRADING_ALLOWED_SYMBOLS=["BTC/USDT","ETH/USDT"]
ALLOW_MAINNET_TRADING=false      # Second opt-in required for real funds
ENABLE_AUTONOMOUS_REAL_TRADING=false  # Allow the background bot to trade real funds
REAL_TRADING_GUARD_INTERVAL_SECONDS=15
REAL_TRADING_RECONCILE_INTERVAL_SECONDS=300
# Native Binance spot OCO (SL/TP protected by the exchange). Test on testnet first.
REAL_TRADING_OCO_ENABLED=false
REAL_TRADING_OCO_STOP_LIMIT_BUFFER_PCT=0.1

# Optional read-only shadow evidence collector (development only).
# It is ignored outside APP_ENV=development and cannot place orders.
SHADOW_SCAN_AUTORUN=false
SHADOW_SCAN_SYMBOLS=["BTC/USDT","ETH/USDT","BNB/USDT","SOL/USDT","XRP/USDT"]
SHADOW_SCAN_INTERVAL_SECONDS=3600
SHADOW_ROUND_TRIP_COST_PCT=0.25

# Read-only opportunity gate. Passing gates only allows manual review; no orders.
OPPORTUNITY_MIN_NET_EDGE_PCT=0.10
OPPORTUNITY_MAX_QUOTED_SPREAD_PCT=0.10
OPPORTUNITY_MAX_SCAN_AGE_SECONDS=900
OPPORTUNITY_MIN_VALIDATED_EVALUATIONS=30

# ---------------------------------------------------------------------------
# Features Flags
# ---------------------------------------------------------------------------
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_FUNDAMENTAL_ANALYSIS=false  # Requires on-chain data providers
ENABLE_MACRO_ANALYSIS=true
ENABLE_AI_AGENTS=true
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json               # json | console (use console for dev)
SENTRY_DSN=                   # Leave empty to disable Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry / Jaeger
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-trading-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus
METRICS_ENABLED=true
METRICS_PORT=9090

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting (requests per window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Notifications / Alerts
# ---------------------------------------------------------------------------
ALERTS_ENABLED=false
ALERT_MIN_SEVERITY=info        # info | success | warning | critical
ALERT_TIMEOUT_SECONDS=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
DATA_HISTORICAL_DAYS=365      # Days of historical data to fetch on startup
DATA_CANDLE_TIMEFRAMES=["1m","5m","15m","1h","4h","1d"]
DEFAULT_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT"]
# Public market-data source: binance (default) or bybit. Execution stays Binance-only.
MARKET_DATA_EXCHANGE=binance

# ---------------------------------------------------------------------------
# Research memory in prompts
# ---------------------------------------------------------------------------
# Opt-in. Only "supported" and current notes are included, inside a bounded
# untrusted-data block. Risk controls and output schema always take precedence.
RESEARCH_CONTEXT_IN_PROMPTS=false
RESEARCH_CONTEXT_MAX_NOTES=5
RESEARCH_CONTEXT_MAX_CHARS=1200
