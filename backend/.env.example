# =============================================================================
# AI Trading Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Trading Assistant"
APP_ENV=development          # development | paper | production
APP_VERSION=0.1.0
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
APP_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1              # Use >1 only in production with gunicorn

# ---------------------------------------------------------------------------
# PostgreSQL + TimescaleDB
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://trading_user:change-this-password@localhost:5432/trading_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false           # Set true to log all SQL (dev only)

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=               # Leave empty for dev
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TTL_SECONDS=300         # Default cache TTL (5 minutes)

# ---------------------------------------------------------------------------
# Exchange APIs
# ---------------------------------------------------------------------------
# Binance (Fase 1 — start with testnet)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true          # MUST be false for real trading
BINANCE_SANDBOX=true

# Bybit (Phase 2+)
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=true

# OKX (Phase 2+)
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true

# Kraken (Phase 2+)
KRAKEN_API_KEY=
KRAKEN_SECRET=

# Coinbase Advanced Trade (Phase 2+)
COINBASE_API_KEY=
COINBASE_SECRET=

# Encryption key for storing API keys in DB (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
# Primary: OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1        # Low temp for consistency in analysis

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-5
ANTHROPIC_MAX_TOKENS=8192

# Google Gemini
GOOGLE_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenRouter (unified gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default LLM provider per agent (can be overridden in DB settings)
AGENT_TECHNICAL_ANALYST_PROVIDER=openai
AGENT_TECHNICAL_ANALYST_MODEL=gpt-4o
AGENT_PRICE_ACTION_PROVIDER=openai
AGENT_PRICE_ACTION_MODEL=gpt-4o
AGENT_SENTIMENT_PROVIDER=google
AGENT_SENTIMENT_MODEL=gemini-2.5-flash
AGENT_MACRO_PROVIDER=anthropic
AGENT_MACRO_MODEL=claude-opus-4-5
AGENT_FUNDAMENTAL_PROVIDER=anthropic
AGENT_FUNDAMENTAL_MODEL=claude-opus-4-5
AGENT_RISK_MANAGER_PROVIDER=openai
AGENT_RISK_MANAGER_MODEL=gpt-4o
AGENT_STRATEGY_OPTIMIZER_PROVIDER=openai
AGENT_STRATEGY_OPTIMIZER_MODEL=o3-mini
AGENT_SUPERVISOR_PROVIDER=ollama
AGENT_SUPERVISOR_MODEL=llama3.2
AGENT_PERFORMANCE_COACH_PROVIDER=anthropic
AGENT_PERFORMANCE_COACH_MODEL=claude-opus-4-5

# ---------------------------------------------------------------------------
# Risk Management
# ---------------------------------------------------------------------------
MAX_DAILY_LOSS_PCT=2.0        # Circuit breaker: halt if daily loss exceeds this
MAX_POSITION_SIZE_PCT=5.0     # Max % of portfolio in a single position
MAX_PORTFOLIO_RISK_PCT=20.0   # Max total exposure
MAX_OPEN_POSITIONS=10
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0

# ---------------------------------------------------------------------------
# Trading Modes
# ---------------------------------------------------------------------------
EXECUTION_MODE=paper          # backtest | paper | real
ENABLE_REAL_TRADING=false     # MUST be explicitly set to true for real trading
REQUIRE_MANUAL_CONFIRMATION=true  # Double-confirm before real orders
PAPER_TRADING_INITIAL_BALANCE=10000.0
PAPER_TRADING_CURRENCY=USDT

# Real-trading safety rails
REAL_TRADING_EXCHANGE=binance
REAL_TRADING_MAX_NOTIONAL=1000
REAL_TRADING_ALLOWED_SYMBOLS=["BTC/USDT","ETH/USDT"]
ALLOW_MAINNET_TRADING=false      # Second opt-in required for real funds
ENABLE_AUTONOMOUS_REAL_TRADING=false  # Allow the background bot to trade real funds
REAL_TRADING_GUARD_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Features Flags
# ---------------------------------------------------------------------------
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_FUNDAMENTAL_ANALYSIS=false  # Requires on-chain data providers
ENABLE_MACRO_ANALYSIS=true
ENABLE_AI_AGENTS=true
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json               # json | console (use console for dev)
SENTRY_DSN=                   # Leave empty to disable Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry / Jaeger
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-trading-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus
METRICS_ENABLED=true
METRICS_PORT=9090

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting (requests per window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Notifications / Alerts
# ---------------------------------------------------------------------------
ALERTS_ENABLED=false
ALERT_MIN_SEVERITY=info        # info | success | warning | critical
ALERT_TIMEOUT_SECONDS=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
DATA_HISTORICAL_DAYS=365      # Days of historical data to fetch on startup
DATA_CANDLE_TIMEFRAMES=["1m","5m","15m","1h","4h","1d"]
DEFAULT_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT"]
